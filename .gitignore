# IDE
.idea/
*.iml

# Claude Code local state
.claude/
# Exception: kit template files live under a .claude/ subdirectory
# because that's the target path they'll be written to. Keep them
# tracked.
!/sandboxed-agent-team/cmd/templates/.claude/
!/sandboxed-agent-team/cmd/templates/.claude/**

# Older/working copies
ignored/

# Go build artifacts (make build writes the host binary to the kit
# root; make release writes per-platform binaries to release/).
/sandboxed-agent-team/agent-team-install
/sandboxed-agent-team/release/
# Stray dev binaries from `go build` inside cmd/.
/sandboxed-agent-team/cmd/sandboxed-agent-team
/sandboxed-agent-team/cmd/cmd
